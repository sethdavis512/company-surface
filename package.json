{
    "name": "company-surface",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "clean": "rm -rf build .react-router test-results playwright-report",
        "db:backfill-titles": "bun tools/backfill-thread-titles.ts",
        "db:deploy": "bunx --bun prisma migrate deploy",
        "db:fresh": "bun run db:reset -- --force && bun run db:seed",
        "db:generate": "bunx --bun prisma generate",
        "db:migrate": "bunx --bun prisma migrate dev",
        "db:push": "bunx --bun prisma db push",
        "db:reset": "bunx --bun prisma migrate reset",
        "db:seed": "bunx --bun prisma db seed",
        "db:studio": "bunx --bun prisma studio",
        "dev": "react-router dev",
        "dev:full": "bun run docker:up && bun run dev",
        "docker:down": "docker compose -f docker-compose.dev.yml down --remove-orphans",
        "docker:nuke": "docker compose -f docker-compose.dev.yml down -v --remove-orphans",
        "docker:up": "docker compose -f docker-compose.dev.yml up -d",
        "format": "prettier --cache --write .",
        "format:check": "prettier --cache --check .",
        "lint": "eslint --cache .",
        "prepare": "husky || true",
        "provision": "bun tools/provision.ts",
        "setup": "bun tools/init.ts",
        "start": "react-router-serve ./build/server/index.js",
        "test": "vitest run",
        "test:all": "bun run test && bun run test:e2e",
        "test:e2e": "playwright test --project=chromium",
        "test:e2e:cross": "playwright test --project=chromium --project=firefox --project=webkit",
        "test:visual": "PW_VISUAL=1 playwright test --project=visual",
        "test:watch": "vitest",
        "trigger:deploy": "bunx trigger.dev@4.6.4 deploy",
        "trigger:dev": "bunx trigger.dev@4.6.4 dev",
        "typecheck": "react-router typegen && tsc",
        "validate": "bun run typecheck && bun run lint && bun run format:check"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.135",
        "@ai-sdk/react": "^3.0.294",
        "@base-ui/react": "^1.8.0",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@hookform/resolvers": "^5.9.1",
        "@mastra/ai-sdk": "^1.10.6",
        "@mastra/core": "^1.74.0",
        "@mastra/memory": "^1.35.0",
        "@mastra/pg": "^1.29.0",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@portabletext/editor": "^8.2.7",
        "@portabletext/plugin-markdown-shortcuts": "^9.0.21",
        "@portabletext/plugin-typeahead-picker": "^7.0.21",
        "@portabletext/react": "8.0.1",
        "@portabletext/toolbar": "^9.0.21",
        "@portabletext/types": "4.0.2",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "@react-email/components": "^1.0.12",
        "@react-email/render": "^2.1.0",
        "@react-router/node": "8.4.0",
        "@react-router/serve": "8.4.0",
        "@sethdavis512/trellis": "git+ssh://git@github.com/sethdavis512/trellis.git#main",
        "@tailwindcss/typography": "^0.5.20",
        "@tanstack/charts": "^1.1.0",
        "@trigger.dev/sdk": "^4.6.4",
        "ai": "^6.0.291",
        "better-auth": "^1.7.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cva": "^1.0.0-beta.12",
        "dotenv": "^18.0.4",
        "isbot": "^5.2.2",
        "lucide-react": "^1.48.0",
        "minisearch": "7.2.0",
        "perfect-freehand": "1.2.3",
        "pg": "^8.23.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.88.0",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "4.12.4",
        "react-router": "8.4.0",
        "resend": "^6.30.0",
        "tailwind-merge": "^3.7.0",
        "tiny-invariant": "^1.3.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inquirer/prompts": "^8.7.2",
        "@playwright/test": "^1.63.0",
        "@react-router/dev": "8.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@trigger.dev/build": "^4.6.4",
        "@types/bun": "^1.4.2",
        "@types/node": "^24.13.6",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "prisma": "^7.10.0",
        "railway": "^3.11.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    },
    "packageManager": "bun@1.4.2",
    "engines": {
        "node": ">=22.22.0"
    }
}
